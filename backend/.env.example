PORT=
API_ID=
API_HASH=
PHONE=
DATABASE_URL=
DIRECT_DATABASE_URL=
STORAGE_PROVIDER=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Telegram Connection Resiliency & Proxy Settings
# Options: "direct" (no proxy), "proxy" (always use proxy), "auto" (try direct, fallback to proxies)
TELEGRAM_PROXY_MODE=auto
# Comma-separated list of custom SOCKS5/MTProto proxies. Examples:
# socks5://127.0.0.1:1080, socks5://user:password@127.0.0.1:1080, mtproto://secret@127.0.0.1:1080, tg://proxy?server=127.0.0.1&port=1080&secret=secret
TELEGRAM_PROXIES=
# Whether to automatically fetch public verified MTProto proxies as fallback when custom proxies are not set or fail
TELEGRAM_FETCH_PUBLIC_PROXIES=true