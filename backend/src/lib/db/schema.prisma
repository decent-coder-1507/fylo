datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Folder {
  id String @id @default(cuid())

  name String

  telegramId BigInt  @unique
  accessHash String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@index([name])
}

model File {
  id String @id @default(uuid())

  name     String
  mimeType String?
  size     Int?
  checksum String?

  telegramMessageId Int
  telegramFileId    String?

  uploadedBy String?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  isChunked   Boolean @default(false)
  totalChunks Int     @default(0)

  // Developer Artifact Metadata
  projectName    String?
  projectVersion String?
  commitHash     String?
  branchName     String?
  buildEnv       String?
  tags           String[] @default([])
  uploaderName   String?
  uploaderEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks     FileChunk[]
  shareLinks ShareLink[]
  preview    FilePreview?
  uploadSession UploadSession?

  @@index([name])
}

model ShareLink {
  id    String @id @default(cuid())
  token String @unique @default(uuid())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([token])
}

model FileChunk {
  id String @id @default(cuid())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  chunkIndex        Int
  telegramMessageId Int

  size Int?

  createdAt DateTime @default(now())

  @@unique([fileId, chunkIndex])
}

model FilePreview {
  id String @id @default(cuid())

  fileId String @unique
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  status PreviewStatus @default(PENDING)

  // Thumbnail support
  thumbnailUrl      String? // Path or URL to the generated thumbnail image
  thumbnailSize     Int? // Size of thumbnail in bytes
  thumbnailMimeType String? // MIME type of thumbnail (e.g. image/jpeg, image/webp)

  // Future-proof preview content fields
  previewUrl      String? // Path/URL to the converted preview (e.g. video transcode, document PDF conversion)
  previewMimeType String? // MIME type of the preview file
  previewSize     Int? // Size of the preview file in bytes

  // Metadata support
  metadata Json? // Custom JSON for file type-specific fields (e.g. video dimensions/duration, audio waveforms, document page counts)

  // Error tracking
  error String? // Error message/stack trace if processing failed

  // Retry tracking
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastAttemptAt DateTime?

  // Processing timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

enum PreviewStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model UploadSession {
  id        String              @id @default(cuid())
  fileName  String
  mimeType  String?
  size      Int
  folderId  String?
  status    UploadSessionStatus @default(CREATED)
  checksum  String?
  isChunked Boolean             @default(false)
  totalChunks Int               @default(0)
  plan      Json?
  deduplicated Boolean         @default(false)

  fileId    String? @unique
  file      File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  // Developer Artifact Metadata
  projectName    String?
  projectVersion String?
  commitHash     String?
  branchName     String?
  buildEnv       String?
  tags           String[] @default([])
  uploaderName   String?
  uploaderEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UploadSessionStatus {
  CREATED
  UPLOADING
  COMPLETED
  FAILED
}
